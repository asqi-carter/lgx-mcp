<?xml version="1.0" encoding="utf-8"?>
<!--
  The Rockwell Logix Designer SDK client package is not on nuget.org and is
  never redistributed with this repository. It comes from your own licensed
  Logix Designer SDK install: copy the .nupkg from that install into
  .localfeed/ (gitignored), which is the "rockwell-local" source below.
  Without a populated .localfeed/ the SDK-backed projects cannot restore.
  At runtime, bootstrap/provision-sdk.ps1 extracts the client DLL from the
  same package into the published app's sdk/vendor/ directory.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="rockwell-local" value=".localfeed" />
  </packageSources>
</configuration>
