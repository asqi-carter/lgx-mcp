<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Lint fixture for ShadowedControllerTag. Controller tags: Motor, Speed, Lamp. MainProgram tags: MOTOR (shadows Motor,
     first referenced at Main rung 1), lamp (shadows Lamp, never referenced -> rung -1), Local (no shadow). -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="LintController" TargetType="Controller" ContainsContext="false">
  <Controller Name="LintController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Motor" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="L5K"><![CDATA[0]]></Data>
      </Tag>
      <Tag Name="Speed" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="DINT" Radix="Decimal">
        <Data Format="L5K"><![CDATA[0]]></Data>
      </Tag>
      <Tag Name="Lamp" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="L5K"><![CDATA[0]]></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Main">
        <Tags>
          <Tag Name="MOTOR" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
            <Data Format="L5K"><![CDATA[0]]></Data>
          </Tag>
          <Tag Name="lamp" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
            <Data Format="L5K"><![CDATA[0]]></Data>
          </Tag>
          <Tag Name="Local" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
            <Data Format="L5K"><![CDATA[0]]></Data>
          </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Local)OTE(Speed);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Local)OTE(motor);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
