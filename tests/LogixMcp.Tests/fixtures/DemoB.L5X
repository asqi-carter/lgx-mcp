<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="DemoController" TargetType="Controller" ContainsContext="false">
  <Controller Name="DemoController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes>
      <!-- MotorCmd is CHANGED: added Direction member -->
      <DataType Name="MotorCmd" Family="NoFamily" Class="User">
        <Members>
          <Member Name="Enable" DataType="BOOL" Dimension="0" Radix="NullType" ExternalAccess="Read/Write" Hidden="false" />
          <Member Name="Speed" DataType="REAL" Dimension="0" Radix="NullType" ExternalAccess="Read/Write" Hidden="false">
            <Description><![CDATA[range 0..100]]></Description>
          </Member>
          <Member Name="Direction" DataType="BOOL" Dimension="0" Radix="NullType" ExternalAccess="Read/Write" Hidden="false" />
        </Members>
      </DataType>
      <!-- SpeedCmd is ADDED -->
      <DataType Name="SpeedCmd" Family="NoFamily" Class="User">
        <Members>
          <Member Name="Target" DataType="REAL" Dimension="0" Radix="NullType" ExternalAccess="Read/Write" Hidden="false" />
        </Members>
      </DataType>
    </DataTypes>
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <!-- Cmd_MotorStart is REMOVED (not present in B) -->
      <!-- Cmd_SpeedSetpoint is CHANGED: DataType REAL → INT -->
      <Tag Name="Cmd_SpeedSetpoint" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="INT" Radix="Decimal">
        <Data Format="Decorated">
          <DataValue DataType="INT" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Sim_LineSpeed" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="REAL" Radix="Float">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
      <Tag Name="Safety_OK" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Motor_Run" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated">
          <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
        </Data>
      </Tag>
      <Tag Name="Cmd_Motor" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="MotorCmd">
        <Data Format="Decorated">
          <Structure DataType="MotorCmd" />
        </Data>
      </Tag>
      <!-- Sim_Pressure is ADDED -->
      <Tag Name="Sim_Pressure" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="REAL" Radix="Float">
        <Data Format="Decorated">
          <DataValue DataType="REAL" Radix="Float" Value="0.0" />
        </Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="MainRoutine">
        <Tags />
        <Routines>
          <!-- MainRoutine is CHANGED: rung 0 text updated -->
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Interlock: Motor_Run coil energized when Safety_OK only]]></Comment>
                <Text><![CDATA[XIC(Safety_OK)OTE(Motor_Run);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Trivial rung]]></Comment>
                <Text><![CDATA[NOP();]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
