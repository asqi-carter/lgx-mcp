<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  DemoUnparsedRungs.L5X - fixture for unparsedRungs reporting and the analyses that rely on unparsed rungs.
  Labelled 36.x (IEC mnemonics).

  P1 rungs:
    0: XIC(Run)OTE(Cmd);              - parses
    1: XIC(Run)OTE(Lonely;            - unbalanced parenthesis; the only rung that mentions Lonely
    2: XIC(\P2 .Flag)OTE(Out2);       - space inside the \Program. qualifier
  P2 owns Flag.
-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="UnparsedCtrl" TargetType="Controller" ContainsContext="false">
  <Controller Name="UnparsedCtrl" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags />
    <Programs>
      <Program Name="P1" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Main">
        <Tags>
        <Tag Name="Run" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Cmd" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Lonely" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Out2" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Run)OTE(Cmd);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Run)OTE(Lonely;]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(\P2 .Flag)OTE(Out2);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="P2" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Main">
        <Tags>
        <Tag Name="Flag" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Flag)OTE(Flag);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="P1" />
          <ScheduledProgram Name="P2" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
