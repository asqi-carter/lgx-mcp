<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  DemoCrossProgram.L5X - fixture for the shared rung-parse helper (RungParser) tests.
  Labelled 36.x, so its rungs use the IEC (v36+) mnemonics (MOVE, not MOV).

  Programs: P1 (the caller) and P2 (owns Src and Bit, referenced as \P2.Src / \P2.Bit).

  P1 rungs:
    0: MOVE(\P2.Src,Dst);            - cross-program source operand
    1: XIC(\P2.Bit)OTE(Local);       - cross-program contact, local coil
    2: XIC(Run)OTE(Local);            - plain rung, no cross-program operand
    3: XIC(Run)OTE(%%unparseable;     - deliberately unparseable (for later tests)
  P2 rungs:
    0: XIC(Bit)OTE(Src_Done);
    1: MOVE(Src,\P1.Dst);            - cross-program destination (writes P1's Dst)
-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="CrossProgCtrl" TargetType="Controller" ContainsContext="false">
  <Controller Name="CrossProgCtrl" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags />
    <Programs>
      <Program Name="P1" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Main">
        <Tags>
        <Tag Name="Dst" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="DINT" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Local" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Run" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[MOVE(\P2.Src,Dst);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(\P2.Bit)OTE(Local);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Run)OTE(Local);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(Run)OTE(%%unparseable;]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="P2" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Main">
        <Tags>
        <Tag Name="Src" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="DINT" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Bit" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        <Tag Name="Src_Done" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
        </Tag>
        </Tags>
        <Routines>
          <Routine Name="Main" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Bit)OTE(Src_Done);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[MOVE(Src,\P1.Dst);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
        <ScheduledPrograms>
          <ScheduledProgram Name="P1" />
          <ScheduledProgram Name="P2" />
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
