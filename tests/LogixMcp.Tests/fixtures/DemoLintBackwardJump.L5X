<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Lint fixture for BackwardJump. MainRoutine: LBL(Again) rung 0, JMP(Again) rung 2 (backward). SameRung: LBL and JMP on rung 0 (fires). Forward: JMP forward (clean). NoLabel: JMP to missing label (ignored). -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="LintController" TargetType="Controller" ContainsContext="false">
  <Controller Name="LintController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Cmd_Start" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
      <Tag Name="Out_A" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="MainRoutine">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[LBL(Again);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)OTE(Out_A);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JMP(Again);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="SameRung" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)LBL(Loop)JMP(Loop);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Forward" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JMP(Skip);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)OTE(Out_A);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[LBL(Skip);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="NoLabel" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JMP(Nowhere);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
