<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Lint fixture for RecursiveJsr. Main calls Ping (rung 0) and Selfie (rung 1). Ping->Pong, Pong->Ping closes a cycle at Pong rung 0.
     Selfie calls itself at rung 0. Clean_Sub is called and acyclic. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="LintController" TargetType="Controller" ContainsContext="false">
  <Controller Name="LintController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Cmd_Start" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
      <Tag Name="Out_A" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="MainRoutine">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Ping,0);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Selfie,0);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Clean_Sub,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Ping" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Pong,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Pong" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Ping,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Selfie" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Selfie,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Clean_Sub" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)OTE(Out_A);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
