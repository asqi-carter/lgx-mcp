<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Lint fixture for ArrayIndexUnchecked. Routine Unchecked: rung 0 is flagged (Arr[Idx], no bound check).
     Routine Checked: rung 0 LIM-checks Idx, so rung 1 is clean. Literal subscripts (Unchecked rung 1) are clean. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="LintController" TargetType="Controller" ContainsContext="false">
  <Controller Name="LintController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Idx" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="DINT" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></Data>
      </Tag>
      <Tag Name="Out" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="DINT" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></Data>
      </Tag>
      <Tag Name="Arr" TagType="Base" DataType="DINT" Dimensions="10" Radix="Decimal" ExternalAccess="Read/Write" Constant="false">
        <Data Format="Decorated"><Array DataType="DINT" Dimensions="10" Radix="Decimal"><Element Index="[0]" Value="0" /><Element Index="[1]" Value="0" /><Element Index="[2]" Value="0" /><Element Index="[3]" Value="0" /><Element Index="[4]" Value="0" /><Element Index="[5]" Value="0" /><Element Index="[6]" Value="0" /><Element Index="[7]" Value="0" /><Element Index="[8]" Value="0" /><Element Index="[9]" Value="0" /></Array></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="Unchecked">
        <Tags />
        <Routines>
          <Routine Name="Unchecked" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[MOVE(Arr[Idx],Out);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[MOVE(Arr[3],Out);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Checked" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[LIMIT(0,Idx,9)MOVE(Arr[Idx],Out);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
