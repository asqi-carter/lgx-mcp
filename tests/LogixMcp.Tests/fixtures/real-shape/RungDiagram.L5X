<Tag Name="Recipe_Src" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" Dimensions="10"><Description><![CDATA[Recipe table source]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag>
