<Tag Name="Guard_Closed" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Guard door closed and locked]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag>
<Tag Name="Fill_Valve" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Fill valve solenoid]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag>
<Tag Name="Fill_Latch" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Fill sequence latched on]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag>
