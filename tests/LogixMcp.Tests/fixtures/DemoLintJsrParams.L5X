<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Lint fixture for JsrParameterMismatch. MainRoutine rung 1 passes 1 input to a 2-input SBR (error); rung 3 expects no return from a 1-value RET (error); rung 4 JSRs a missing routine (not reported here); rungs 0, 2, 5 are fine. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="36.1" TargetName="LintController" TargetType="Controller" ContainsContext="false">
  <Controller Name="LintController" MajorRev="36" MinorRev="1" ProcessorType="1756-L84E">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions />
    <Tags>
      <Tag Name="Cmd_Start" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
      <Tag Name="Out_A" TagType="Base" ExternalAccess="Read/Write" Constant="false" DataType="BOOL" Radix="Decimal">
        <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></Data>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram" Type="Normal" TestEdits="false" Disabled="false" UseAsFolder="false" MainRoutineName="MainRoutine" FaultRoutineName="FaultRoutine">
        <Tags />
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Takes_Two,2,Cmd_Start,Out_A);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Takes_Two,1,Cmd_Start);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Returns_One,0,Out_A);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Returns_One,0);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Ghost,0);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)JSR(Plain_Sub,0);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Takes_Two" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[SBR(In_A,In_B);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)OTE(Out_A);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Returns_One" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[SBR();]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Text><![CDATA[XIC(Cmd_Start)RET(Out_A);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Plain_Sub" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[NOP();]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="FaultRoutine" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Text><![CDATA[NOP();]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks />
    <ParameterConnections />
    <Trends />
    <QuickWatchLists />
  </Controller>
</RSLogix5000Content>
