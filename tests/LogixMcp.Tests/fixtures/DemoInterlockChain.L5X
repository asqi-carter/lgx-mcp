<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  DemoInterlockChain.L5X — intermediate-bit chain fixture for VerifyInterlockHandler tests. Condition tag is Cond.
    Drive      XIC(StartBit)OTE(Drive);  XIC(Cond)XIC(Start)OTE(StartBit)                  -> verified via [StartBit]
    DriveBad   XIC(BadBit)OTE(DriveBad); XIC(Cond)XIC(Start)OTE(BadBit); XIC(Other)OTE(BadBit) -> not verified, names rung 6
    DriveLU    XIC(LatchBit)OTE(DriveLU); XIC(Cond)XIC(Start)OTL(LatchBit); XIO(Stop)OTU(LatchBit) -> verified (OTU only clears)
    Drive3     Drive3 <- D3A <- D3B <- D3C <- Cond                                         -> verified (depth 3)
    Drive4     Drive4 <- D4A <- D4B <- D4C <- D4D <- Cond                                  -> not verified, depth-limit
    OutLU      XIC(Cond)XIC(Start)OTL(OutLU); XIO(Stop)OTU(OutLU)                          -> verified, unlatch writer listed
    OutAfter   XIC(Start)OTE(OutAfter)XIC(Cond)OTE(AfterSink)                              -> not verified, condition-after-output
    DriveXio   XIO(XioBit)OTE(DriveXio); XIC(Cond)XIC(Start)OTE(XioBit)                    -> not verified, xio-of-guarded-bit
-->
